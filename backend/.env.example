# Copy this file to a new file named ".env" (same folder) and fill in your values.

# REQUIRED — Google Gemini API key.
# Get a FREE key (no credit card) at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_key_here

# OPTIONAL — folder where the Chroma vector store is persisted.
# Default: a "chroma_db" folder next to rag_engine.py (independent of the
# directory you launch uvicorn from).
# PERSIST_DIR=C:\path\to\chroma_db

# OPTIONAL — comma-separated list of frontend origins allowed by CORS.
# Default: http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://studymind.example.com

# OPTIONAL — if set (non-empty), every endpoint except /health requires the
# HTTP header:  Authorization: Bearer <this value>
# Leave it unset for local development (no auth).
# APP_ACCESS_TOKEN=choose-a-long-random-string

# OPTIONAL — Google Sign-In. Set your OAuth 2.0 Web Client ID (from
# console.cloud.google.com -> APIs & Services -> Credentials) to switch the
# app into Google-auth mode: users sign in with Google and EVERY user's
# documents and chats are isolated to their own account. Overrides
# APP_ACCESS_TOKEN. The frontend needs the SAME id as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# GOOGLE_OAUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# OPTIONAL — the model fallback chain (comma-separated, order = preference).
# Google's free quotas are PER MODEL, so each entry is an independent daily
# pool on the same key; when one is limited the app hops to the next.
# GEMINI_MODEL_CHAIN=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash

# OPTIONAL — the hour (UTC) when Google's free quotas reset (midnight Pacific).
# 7 = PDT (summer). Use 8 during PST (winter) if the usage bar looks off.
# QUOTA_RESET_HOUR_UTC=7
